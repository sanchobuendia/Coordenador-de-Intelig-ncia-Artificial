    1: def run_extractor(state: dict) -> dict:
    8:     logger.info("[%s] Iniciando extração", state["session_id"])
    8:     logger.debug("[%s] Extração via LLM", state["session_id"])
    8:     try:
    8:         extracted = llm_extract(state)
    8:     except Exception as exc:  # pragma: no cover - exercised in tests via monkeypatch
    8:         logger.warning("[%s] Falha na extração via LLM; usando fallback heurístico: %s", state["session_id"], exc)
    8:         extracted = heuristic_extract(state)
    8:     logger.info("[%s] Extração concluída", state["session_id"])
    8:     logger.debug("[%s] Fatos extraídos: %s", state["session_id"], extracted.model_dump(mode="json"))
    8:     return {"extracted_facts": extracted}
