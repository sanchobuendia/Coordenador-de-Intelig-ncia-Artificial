    1: def heuristic_evaluate(criterion: dict, facts: ExtractedFacts) -> CriterionScore:
   37:     handlers = {
   37:         "C1": _score_c1,
   37:         "C2": _score_c2,
   37:         "C3": _score_c3,
   37:         "C4": _score_c4,
   37:         "C5": _score_c5,
           }
