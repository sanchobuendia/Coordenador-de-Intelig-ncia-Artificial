    1: def run_evaluator(state: dict) -> dict:
   35:     criterion = state["criterion"]
   35:     facts = state["extracted_facts"]
   35:     session_id = facts.metadata.session_id
   35:     logger.info("[%s] Avaliando critério %s", session_id, criterion["id"])
   35:     logger.debug("[%s] Critério %s via regra determinística", session_id, criterion["id"])
   35:     score = heuristic_evaluate(criterion, facts)
   35:     logger.info("[%s] Critério %s concluído com score %.1f", session_id, criterion["id"], score.score)
   35:     logger.debug("[%s] Critério %s detalhes: %s", session_id, criterion["id"], score.model_dump(mode="json"))
   35:     return {"criterion_scores": [score]}
